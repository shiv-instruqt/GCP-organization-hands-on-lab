#!/bin/bash
# Solve script (t_impersonate_dev) - runs when the learner skips this challenge.
# shellcheck disable=SC1091
source /opt/lab/lib.sh || exit 1

solve_one() {

case "$CHECK" in
  token_creator)
    gdev iam service-accounts add-iam-policy-binding "$DEV_ALICE" \
      --member="serviceAccount:$DEV_ADMIN_SA" --role=roles/iam.serviceAccountTokenCreator >/dev/null ;;
  object_uploaded)
    echo "hello from alice" > /root/week1/hello.txt
    gdev storage cp /root/week1/hello.txt "gs://$DEV_BUCKET/hello.txt" ;;
  impersonated_ok)
    log_note 0 "$DEV_ALICE" "gcloud storage ls gs://$DEV_BUCKET --impersonate-service-account=$DEV_ALICE   # (auto-solved)" ;;
  impersonated_denied)
    log_note 1 "$DEV_ALICE" "gcloud storage rm gs://$DEV_BUCKET/hello.txt --impersonate-service-account=$DEV_ALICE   # (auto-solved)" ;;
esac
}

for CHECK in token_creator object_uploaded impersonated_ok impersonated_denied; do
  echo "Solving: $CHECK"
  solve_one
done
exit 0
